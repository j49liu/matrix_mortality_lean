import Mortality.SourceMachine.U2Table

/-!
# Operational semantics for U2

This file gives the concrete table an executable semantics.  A source
step is a partial function because the halt instruction has no
successor.  `Reaches` is the reflexive transitive closure generated by
that function.

The quotient map changes only the control state.  The generic
`execute_mapState` theorem isolates the semantic argument needed for
the four finite table identifications: once the mapped instructions
agree, their steps commute with projection for all counter values.
-/

namespace Mortality.SourceMachine

/-- A configuration of a two-counter source machine. -/
structure Configuration where
  state : Nat
  counterZero : Nat
  counterOne : Nat
  deriving DecidableEq, Repr

namespace Configuration

/-- Read one of the two counters. -/
def readCounter (configuration : Configuration) : Counter → Nat
  | .zero => configuration.counterZero
  | .one => configuration.counterOne

/-- Replace one counter, leaving the other one unchanged. -/
def setCounter (configuration : Configuration) : Counter → Nat → Configuration
  | .zero, value => { configuration with counterZero := value }
  | .one, value => { configuration with counterOne := value }

/-- Replace only the control state. -/
def setState (configuration : Configuration) (state : Nat) : Configuration :=
  { configuration with state }

/-- Apply a map to the control state and leave both counters unchanged. -/
def mapState (f : Nat → Nat) (configuration : Configuration) : Configuration :=
  { configuration with state := f configuration.state }

@[simp] theorem readCounter_setState (configuration : Configuration)
    (counter : Counter) (state : Nat) :
    (configuration.setState state).readCounter counter =
      configuration.readCounter counter := by
  cases counter <;> rfl

@[simp] theorem mapState_setState (f : Nat → Nat)
    (configuration : Configuration) (state : Nat) :
    (configuration.setState state).mapState f =
      configuration.setState (f state) := by
  rfl

@[simp] theorem mapState_setCounter (f : Nat → Nat)
    (configuration : Configuration) (counter : Counter) (value : Nat) :
    (configuration.setCounter counter value).mapState f =
      (configuration.mapState f).setCounter counter value := by
  cases counter <;> rfl

end Configuration

/-- Execute one instruction at a configuration.

The configuration's current `state` is ignored: the caller chooses the
instruction.  Every non-halt instruction writes its stated destination.
-/
def execute (instruction : RawInstruction)
    (configuration : Configuration) : Option Configuration :=
  match instruction with
  | .inc counter next =>
      some <| (configuration.setCounter counter
        (configuration.readCounter counter + 1)).setState next
  | .dec counter positive zeroDest =>
      match configuration.readCounter counter with
      | 0 => some <| configuration.setState zeroDest
      | value + 1 =>
          some <| (configuration.setCounter counter value).setState positive
  | .halt => none

/-- A successful instruction step uses one of its listed destinations. -/
theorem execute_state_mem {instruction : RawInstruction}
    {before after : Configuration} (stepEq : execute instruction before = some after) :
    after.state ∈ instruction.destinations := by
  cases instruction with
  | inc counter next =>
      cases counter <;> cases before <;>
        simp only [execute, Configuration.readCounter, Configuration.setCounter,
          Configuration.setState, Option.some.injEq] at stepEq <;>
        cases stepEq <;> simp [RawInstruction.destinations]
  | dec counter positive zeroDest =>
      cases before with
      | mk state counterZero counterOne =>
          cases counter
          · cases counterZero <;>
              simp only [execute, Configuration.readCounter, Configuration.setCounter,
                Configuration.setState, Option.some.injEq] at stepEq <;>
              cases stepEq <;> simp [RawInstruction.destinations]
          · cases counterOne <;>
              simp only [execute, Configuration.readCounter, Configuration.setCounter,
                Configuration.setState, Option.some.injEq] at stepEq <;>
              cases stepEq <;> simp [RawInstruction.destinations]
  | halt => simp [execute] at stepEq

/-- Mapping instruction destinations commutes with one-step execution. -/
theorem execute_mapState (f : Nat → Nat) (instruction : RawInstruction)
    (configuration : Configuration) :
    execute (instruction.mapStates f) (configuration.mapState f) =
      (execute instruction configuration).map (Configuration.mapState f) := by
  cases instruction with
  | inc counter next => cases counter <;> rfl
  | dec counter positive zeroDest =>
      cases configuration with
      | mk state counterZero counterOne =>
          cases counter
          · cases counterZero <;> rfl
          · cases counterOne <;> rfl
  | halt => rfl

/-- One step of the unquotiented U2 table. -/
def u2Step (configuration : Configuration) : Option Configuration :=
  (u2At configuration.state).bind fun instruction =>
    execute instruction configuration

/-- Every successful U2 step lands at a valid source state. -/
theorem u2Step_state_bounds {before after : Configuration}
    (stepEq : u2Step before = some after) :
    1 ≤ after.state ∧ after.state ≤ 278 := by
  unfold u2Step at stepEq
  cases lookup : u2At before.state with
  | none => simp [lookup] at stepEq
  | some instruction =>
      simp [lookup] at stepEq
      exact u2At_destination_bounds lookup (execute_state_mem stepEq)

/-- The projected version of a configuration. -/
def projectConfiguration (configuration : Configuration) : Configuration :=
  configuration.mapState quotientState

/-- Look up the quotient instruction using a representative state. -/
def quotientAt (state : Nat) : Option RawInstruction :=
  if quotientState state = state then
    (u2At state).map (RawInstruction.mapStates quotientState)
  else none

/-- The quotient retains state 278 as its unique halt state. -/
@[simp] theorem quotientAt_halt : quotientAt 278 = some .halt := by
  decide

/-- Every successful quotient lookup uses one of the chosen representatives. -/
theorem quotientAt_state_mem {state : Nat} {instruction : RawInstruction}
    (lookup : quotientAt state = some instruction) :
    state ∈ quotientStates := by
  unfold quotientAt at lookup
  split at lookup
  · rename_i representative
    cases originalLookup : u2At state with
    | none => simp [originalLookup] at lookup
    | some original =>
        have bounds := u2At_state_bounds originalLookup
        apply List.mem_filter.mpr
        constructor
        · apply List.mem_map.mpr
          refine ⟨state - 1, ?_, ?_⟩
          · simp
            omega
          · omega
        · simp [representative]
  · contradiction

/-- One step of the quotient machine, on representative state labels. -/
def quotientStep (configuration : Configuration) : Option Configuration :=
  (quotientAt configuration.state).bind fun instruction =>
    execute instruction configuration

/-- A U2 step commutes with projection whenever its source state is valid. -/
theorem quotientStep_project (configuration : Configuration)
    (positive : 1 ≤ configuration.state) (bounded : configuration.state ≤ 278) :
    quotientStep (projectConfiguration configuration) =
      (u2Step configuration).map projectConfiguration := by
  unfold quotientStep quotientAt projectConfiguration u2Step
  change
    (if quotientState (quotientState configuration.state) =
        quotientState configuration.state then
      (u2At (quotientState configuration.state)).map
        (RawInstruction.mapStates quotientState)
    else none).bind
        (fun instruction => execute instruction (configuration.mapState quotientState)) =
      ((u2At configuration.state).bind
        (fun instruction => execute instruction configuration)).map
          (Configuration.mapState quotientState)
  simp only [quotientState_idempotent, ↓reduceIte]
  rw [← quotient_instruction_eq positive bounded]
  cases instructionEq : u2At configuration.state with
  | none => simp
  | some instruction =>
      simp [execute_mapState]

/-- A reflexive transitive run of a deterministic partial step function. -/
inductive Reaches {α : Type} (step : α → Option α) : α → α → Prop
  | refl (start : α) : Reaches step start start
  | tail {start middle finish : α} :
      Reaches step start middle →
      step middle = some finish →
      Reaches step start finish

namespace Reaches

/-- One successful step is a run. -/
theorem single {α : Type} {step : α → Option α} {start finish : α}
    (h : step start = some finish) : Reaches step start finish :=
  .tail (.refl start) h

/-- Concatenate two finite runs. -/
theorem trans {α : Type} {step : α → Option α} {start middle finish : α}
    (first : Reaches step start middle) (second : Reaches step middle finish) :
    Reaches step start finish := by
  induction second with
  | refl => exact first
  | tail hRun stepEq inductionHypothesis =>
      exact .tail inductionHypothesis stepEq

/-- Map a run through a function that commutes with successful steps. -/
theorem map {α β : Type} {sourceStep : α → Option α}
    {targetStep : β → Option β} (f : α → β)
    (commutes : ∀ {a a'}, sourceStep a = some a' →
      targetStep (f a) = some (f a'))
    {start finish : α} (run : Reaches sourceStep start finish) :
    Reaches targetStep (f start) (f finish) := by
  induction run with
  | refl => exact .refl _
  | tail hRun stepEq inductionHypothesis =>
      exact .tail inductionHypothesis (commutes stepEq)

/-- A state invariant preserved by each successful step holds along a run. -/
theorem invariant {α : Type} {step : α → Option α} (property : α → Prop)
    (preserved : ∀ {before after}, property before →
      step before = some after → property after)
    {start finish : α} (run : Reaches step start finish)
    (initial : property start) : property finish := by
  induction run with
  | refl => exact initial
  | @tail middle finish hRun hStep inductionHypothesis =>
      exact preserved inductionHypothesis hStep

end Reaches

/-- All states along a run from a valid U2 configuration remain valid. -/
theorem u2Run_state_bounds {start finish : Configuration}
    (run : Reaches u2Step start finish)
    (positive : 1 ≤ start.state) (bounded : start.state ≤ 278) :
    1 ≤ finish.state ∧ finish.state ≤ 278 :=
  run.invariant (fun configuration =>
    1 ≤ configuration.state ∧ configuration.state ≤ 278)
    (fun _ stepEq => u2Step_state_bounds stepEq) ⟨positive, bounded⟩

/-- Project every U2 run to a run of the quotient machine. -/
theorem projectRun {start finish : Configuration}
    (run : Reaches u2Step start finish)
    (positive : 1 ≤ start.state) (bounded : start.state ≤ 278) :
    Reaches quotientStep (projectConfiguration start)
      (projectConfiguration finish) := by
  induction run with
  | refl => exact .refl _
  | @tail middle finish hRun hStep inductionHypothesis =>
      have middleBounds := u2Run_state_bounds hRun positive bounded
      refine Reaches.tail inductionHypothesis ?_
      rw [quotientStep_project middle middleBounds.1 middleBounds.2, hStep]
      rfl

/-- One quotient step from a projected configuration lifts to a U2 step. -/
theorem liftQuotientStep {before quotientAfter : Configuration}
    (positive : 1 ≤ before.state) (bounded : before.state ≤ 278)
    (stepEq : quotientStep (projectConfiguration before) = some quotientAfter) :
    ∃ after, u2Step before = some after ∧
      projectConfiguration after = quotientAfter := by
  rw [quotientStep_project before positive bounded] at stepEq
  cases originalStep : u2Step before with
  | none => simp [originalStep] at stepEq
  | some after =>
      refine ⟨after, rfl, ?_⟩
      simpa [originalStep] using stepEq

/-- Every quotient run from a projected state lifts to an original U2 run. -/
theorem liftQuotientRun {source quotientFinish : Configuration}
    (run : Reaches quotientStep (projectConfiguration source) quotientFinish)
    (positive : 1 ≤ source.state) (bounded : source.state ≤ 278) :
    ∃ finish, Reaches u2Step source finish ∧
      projectConfiguration finish = quotientFinish := by
  induction run with
  | refl => exact ⟨source, .refl _, rfl⟩
  | @tail middle quotientFinish prefixRun quotientStepEq inductionHypothesis =>
      obtain ⟨originalMiddle, originalRun, projectedMiddle⟩ :=
        inductionHypothesis
      have middleBounds := u2Run_state_bounds originalRun positive bounded
      have projectedStep :
          quotientStep (projectConfiguration originalMiddle) = some quotientFinish := by
        rw [projectedMiddle]
        exact quotientStepEq
      obtain ⟨originalFinish, originalStep, projectedFinish⟩ :=
        liftQuotientStep middleBounds.1 middleBounds.2 projectedStep
      exact ⟨originalFinish, .tail originalRun originalStep, projectedFinish⟩

/-- U2 starts at `q1`, with its input in counter zero and scratch counter zero. -/
def initialConfiguration (input : Nat) : Configuration :=
  { state := 1, counterZero := input, counterOne := 0 }

/-- The unique U2 halt state. -/
def haltConfiguration (counterZero counterOne : Nat) : Configuration :=
  { state := 278, counterZero, counterOne }

@[simp] theorem projectConfiguration_initial (input : Nat) :
    projectConfiguration (initialConfiguration input) =
      initialConfiguration input := by
  rfl

@[simp] theorem projectConfiguration_halt (counterZero counterOne : Nat) :
    projectConfiguration (haltConfiguration counterZero counterOne) =
      haltConfiguration counterZero counterOne := by
  rfl

theorem projectConfiguration_eq_halt_iff (configuration : Configuration)
    (counterZero counterOne : Nat) :
    projectConfiguration configuration = haltConfiguration counterZero counterOne ↔
      configuration = haltConfiguration counterZero counterOne := by
  cases configuration
  simp [projectConfiguration, Configuration.mapState, haltConfiguration]

/-- U2 halts on an input when a finite run reaches its halt state. -/
def U2Halts (input : Nat) : Prop :=
  ∃ counterZero counterOne,
    Reaches u2Step (initialConfiguration input)
      (haltConfiguration counterZero counterOne)

/-- The quotient machine halts on the same encoded input. -/
def QuotientHalts (input : Nat) : Prop :=
  ∃ counterZero counterOne,
    Reaches quotientStep (initialConfiguration input)
      (haltConfiguration counterZero counterOne)

/-- The four state identifications preserve and reflect halting. -/
theorem quotientHalts_iff_u2Halts (input : Nat) :
    QuotientHalts input ↔ U2Halts input := by
  constructor
  · rintro ⟨counterZero, counterOne, quotientRun⟩
    have quotientRun' :
        Reaches quotientStep (projectConfiguration (initialConfiguration input))
          (haltConfiguration counterZero counterOne) := by
      simpa using quotientRun
    obtain ⟨finish, originalRun, projectedFinish⟩ :=
      liftQuotientRun quotientRun' (by simp [initialConfiguration])
        (by simp [initialConfiguration])
    have finishEq : finish = haltConfiguration counterZero counterOne :=
      (projectConfiguration_eq_halt_iff finish counterZero counterOne).mp
        projectedFinish
    exact ⟨counterZero, counterOne, finishEq ▸ originalRun⟩
  · rintro ⟨counterZero, counterOne, originalRun⟩
    have quotientRun := projectRun originalRun
      (by simp [initialConfiguration]) (by simp [initialConfiguration])
    exact ⟨counterZero, counterOne, by simpa using quotientRun⟩

end Mortality.SourceMachine
